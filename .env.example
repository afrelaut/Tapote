# Environnement
NODE_ENV=development
PUBLIC_URL=http://localhost:5173
API_PORT=3001
LOG_LEVEL=debug

# Laisser vide en déploiement même origine. Ajouter uniquement les origines
# explicitement autorisées si le frontend et l'API sont servis séparément.
ALLOWED_ORIGINS=
# Nombre exact de reverse proxies maîtrisés devant Express (ex. 1 sur Railway/Render).
TRUST_PROXY_HOPS=0

# Paiement Stripe — valeurs secrètes uniquement côté serveur
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Mode démo strictement local. Il est désactivé par le code en production.
ALLOW_DEMO_CHECKOUT=true

# Supabase PostgreSQL. Utiliser la connexion pooler adaptée à l'hébergeur.
DATABASE_URL=
DATABASE_SSL=true

# Supabase Storage côté serveur. Préférer la nouvelle Secret key Supabase.
# Ne jamais utiliser une variable VITE_ pour cette clé.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=tapote-order-assets

# Tapote Pilot — seules l’URL et la clé publiable sont intégrées au navigateur.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PILOT_DEMO=false
VITE_REDIRECT_BASE_URL=https://t.tapote.fr

# TAPOTE Gestion utilise les mêmes URL et clé publiable, mais une session
# navigateur séparée. Les comptes sont créés uniquement via management:invite.

# Comptes techniques révocables utilisés uniquement par platform:verify.
# Ne jamais renseigner ces valeurs dans GitHub ni dans un build frontend.
TEST_MANAGEMENT_EMAIL=
TEST_MANAGEMENT_PASSWORD=
TEST_PILOT_EMAIL=
TEST_PILOT_PASSWORD=

# Notifications de commandes/devis
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
FROM_EMAIL=Tapote <commandes@tapote.fr>
OUTBOX_INTERVAL_MS=10000

# Supervision facultative mais recommandée
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Verrou juridique serveur. La même version doit être utilisée côté site.
LEGAL_READY=false
LEGAL_VERSION=2026-07-16

# Mentions affichées publiquement. À faire valider avant LEGAL_READY=true.
VITE_LEGAL_COMPANY=
VITE_LEGAL_CAPITAL=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_REGISTRATION=
VITE_LEGAL_VAT=
VITE_LEGAL_DIRECTOR=
VITE_LEGAL_CONTACT=
VITE_LEGAL_HOST=
VITE_LEGAL_MEDIATOR=
VITE_LEGAL_PRIVACY_CONTACT=
VITE_LEGAL_RETURNS_ADDRESS=
VITE_LEGAL_VERSION=2026-07-16
