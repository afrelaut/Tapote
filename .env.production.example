# Copie ce fichier vers .env.production sur le VPS, puis renseigne chaque valeur vide.
# Ce fichier réel ne doit jamais être commité, envoyé par e-mail ou collé dans un chat.

NODE_ENV=production
PUBLIC_URL=https://tapote.fr
API_PORT=3001
# Utilise uniquement le mode VPS partagé. Ce port reste lié à 127.0.0.1.
TAPOTE_HOST_PORT=3011
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
ALLOWED_ORIGINS=https://tapote.fr,https://gestion.tapote.fr
ALLOW_DEMO_CHECKOUT=false

# Stripe serveur : utiliser d'abord les valeurs sandbox, puis les valeurs live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Autorise temporairement le parcours Checkout avec sk_test_ sur le VPS.
# /api/ready reste à 503 jusqu'au passage en sk_live_. Remettre false après le test.
STRIPE_SANDBOX_CHECKOUT_ENABLED=false
# Valeur publique utilisée uniquement pour adapter les textes du checkout.
# Mettre live seulement en même temps que les clés Stripe live.
VITE_STRIPE_MODE=sandbox

# PostgreSQL Supabase : connexion pooler, mot de passe encodé pour une URL.
DATABASE_URL=
DATABASE_SSL=true

# Supabase serveur. Cette clé ne doit jamais porter le préfixe VITE_.
SUPABASE_URL=https://pesgnpchntoxosthgzek.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=tapote-order-assets

# Pilot : valeurs publiques intégrées au JavaScript pendant le build Docker.
VITE_SUPABASE_URL=https://pesgnpchntoxosthgzek.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PILOT_DEMO=false
VITE_REDIRECT_BASE_URL=https://t.tapote.fr

# E-mails transactionnels.
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=commandes@tapote.fr
FROM_EMAIL='Tapote <commandes@tapote.fr>'
OUTBOX_INTERVAL_MS=10000

# Supervision facultative, recommandée avant le trafic payant.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Barrière temporaire devant l'application Gestion.
# Les valeurs bcrypt doivent rester entourées d'apostrophes pour préserver les $.
GESTION_AYMERIC_PASSWORD_HASH=
GESTION_JULES_PASSWORD_HASH=

# Mentions légales publiques de l'entreprise individuelle qui exploite Tapote.
LEGAL_READY=true
LEGAL_VERSION=2026-07-19
VITE_LEGAL_COMPANY='Aymeric Frelaut (Tapote)'
VITE_LEGAL_CAPITAL='Entrepreneur individuel (EI) - micro-entreprise, capital social non applicable'
VITE_LEGAL_ADDRESS='24 rue Labouret, 92700 Colombes, France'
VITE_LEGAL_REGISTRATION='SIREN 105 019 103 - SIRET 105 019 103 00016 - immatriculé au RNE le 15 mai 2026'
VITE_LEGAL_VAT='TVA non applicable, article 293 B du CGI'
VITE_LEGAL_DIRECTOR='Aymeric Frelaut'
VITE_LEGAL_CONTACT='aymeric@tapote.fr - +33 6 63 15 04 49'
VITE_LEGAL_HOST='HOSTINGER INTERNATIONAL LIMITED, 61 Lordou Vironos str., 6023 Larnaca, Chypre - compliance@hostinger.com'
VITE_LEGAL_PRIVACY_CONTACT='aymeric@tapote.fr'
VITE_LEGAL_RETURNS_ADDRESS='24 rue Labouret, 92700 Colombes, France'
VITE_LEGAL_DATA_RETENTION='Demandes commerciales sans commande : 3 ans après le dernier contact ; journaux de sécurité : 12 mois hors incident ou obligation légale ; fichiers de personnalisation : exécution de la commande puis 3 ans pour le support et la défense des droits.'
VITE_LEGAL_VERSION=2026-07-22
