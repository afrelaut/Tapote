{
  "name": "tapote",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"node --watch --import ./server/instrument.js server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch --import ./server/instrument.js server/index.js",
    "build": "vite build",
    "start": "node --import ./server/instrument.js server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "node scripts/playwright-audit-storefront-v3.mjs",
    "ci": "npm run lint && npm test && npm run build && npm audit --omit=dev --audit-level=high",
    "supabase:migrate": "supabase db push",
    "supabase:provision-storage": "node scripts/provision-storage.js",
    "pilot:invite": "node scripts/invite-pilot-user.js",
    "pilot:activate-order": "node scripts/activate-pilot-order.js",
    "management:invite": "node scripts/invite-management-user.js",
    "management:verify": "node scripts/verify-management-supabase.js",
    "platform:verify": "node scripts/verify-platform-supabase.js"
  },
  "dependencies": {
    "@sentry/node": "10.67.0",
    "@supabase/supabase-js": "2.110.8",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "file-type": "22.0.1",
    "helmet": "8.3.0",
    "multer": "2.2.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "stripe": "22.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "9.2.4",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "supabase": "2.109.1",
    "supertest": "7.2.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
